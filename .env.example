# Folder holding theme directories (default: the themes bundled in the package)
# SLIDER_THEMES_DIR=themes
# SLIDER_LOG_LEVEL=INFO

# --format video
# SLIDER_VIDEO_WIDTH=1920
# SLIDER_VIDEO_HEIGHT=1080
# SLIDER_VIDEO_FPS=30
# Voice used when the deck does not set deck.voice.speaker
# SLIDER_VOICE=en-US-AvaMultilingualNeural
# Seconds of quiet before each spoken moment, after it, and for a moment with no narration
# SLIDER_LEAD=0.4
# SLIDER_GAP=0.6
# SLIDER_HOLD=2.0
# Where narration clips are cached between runs
# SLIDER_AUDIO_CACHE=.cache/audio
# ffmpeg to use instead of the copy bundled with imageio-ffmpeg
# SLIDER_FFMPEG=
